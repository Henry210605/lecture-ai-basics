    "# Ansatz: da die Daten zeitlich geordnet sind, \n",
    "# ersetzen wir fehlende Werte in den numerischen Spalten \n",
    "# durch lineare Interpolation. Wenn dann noch Werte am Anfang \n",
    "# oder Ende fehlen werden die mit Forward-/Backwardfill\n",
    "# ergänzt.\n",
    "\n",
    "# IHRE Lösung HIER\n",
    "\n",
    "# Kopieren\n",
    "ebola_without_nans = ebola.copy()\n",
    "\n",
    "# Nur numerische Spalten auswählen\n",
    "numeric_columns = ebola_without_nans.select_dtypes(\n",
    "    include=\"number\"\n",
    ").columns\n",
    "\n",
    "# Interpolate, Ffill, Bfill auf numerische Spalten anwenden\n",
    "ebola_without_nans[numeric_columns] = (\n",
    "    ebola_without_nans[numeric_columns].interpolate(method=\"linear\").ffill().bfill()\n",
    ")\n",
    "\n",
    "ebola_without_nans\n",
    "\n",
    "\n"
   ]
