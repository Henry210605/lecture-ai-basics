    "def classify(data):\n",
    "    labels = None\n",
    "\n",
    "    line_y = (4 / 3) * data[:, 0] + ( 2 / 3)\n",
    "\n",
    "    labels = np.where(\n",
    "        data[:, 1] > line_y,\n",
    "        \"A\",\n",
    "        \"B\"\n",
    "    )\n",
    "\n",
    "    return labels"
