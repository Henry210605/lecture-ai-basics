    "# IHRE Lösung HIER\n",
    "\n",
    "def sq_mi_in_sq_km(series):\n",
    "    return series / 0.386102\n",
    "\n",
    "# Erst numeric, dann in km\n",
    "# Bei Pop. Density besonderer Fall wegen Dezimalzahlen\n",
    "countries[\"Pop. Density (per sq. mi.)\"] = pd.to_numeric(\n",
    "    countries[\"Pop. Density (per sq. mi.)\"]\n",
    "    .astype(str)\n",
    "    .str.strip()\n",
    "    .str.replace(\",\", \".\", regex=False),\n",
    "    errors=\"coerce\",\n",
    ")\n",
    "countries[\"Area (sq. mi.)\"] = pd.to_numeric(\n",
    "    countries[\"Area (sq. mi.)\"],\n",
    "    errors=\"coerce\",\n",
    ")\n",
    "\n",
    "countries[\"Area (sq. mi.)\"] = sq_mi_in_sq_km(\n",
    "    countries[\"Area (sq. mi.)\"]\n",
    ")\n",
    "\n",
    "countries[\"Pop. Density (per sq. mi.)\"] = sq_mi_in_sq_km(\n",
    "    countries[\"Pop. Density (per sq. mi.)\"]\n",
    ")\n",
    "\n",
    "countries.rename(\n",
    "    columns={\n",
    "        \"Area (sq. mi.)\": \"Area (sq. km.)\",\n",
    "        \"Pop. Density (per sq. mi.)\": \"Pop. Density (per sq. km.)\"\n",
    "    },\n",
    "    inplace=True,\n",
    ")\n",
    "\n",
    "countries"
   ]
